{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TaskPulse.Api",
    "Audience": "TaskPulse.Client",
    "AccessTokenExpirationMinutes": 15
  },
  // placeholders
  "Email": {
    "VerificationBaseUrl": "https://localhost:7120/api/auth/verify-email",
    "PasswordResetBaseUrl": "https://localhost:3000/reset-password"
  }
}